<div id="cas-usages" class="fr-container--fluid">
  <div class="banner fr-pt-5w fr-pb-8w">
    <div class="fr-container">
      <h1><%= t('.title') %></h1>
      <p class="fr-text--lead"><%= t('.description').html_safe %></p>
    </div>
  </div>

  <div class="content fr-container fr-mt-5w fr-mb-5w">
    <% if @fiches_pratiques.any? %>
      <h2 class="fr-h3"><%= t('.internal.title') %></h2>
      <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
        <% @fiches_pratiques.each do |fiche_pratique| %>
          <div class="fr-col-12 fr-col-sm-6 fr-col-md-4">
            <%= render 'shared/cas_usages/internal_use_case_card',
              title: t(".cards.#{fiche_pratique.uid}.title"),
              url: cas_usage_path(fiche_pratique.uid),
              description: t(".cards.#{fiche_pratique.uid}.description"),
              user_types: fiche_pratique.user_types,
              content_category: fiche_pratique.content_category,
              api: 'api_particulier',
              uid: fiche_pratique.uid %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @cas_usages.any? %>
      <h2 class="fr-h3 fr-mt-6w"><%= t('.simplifions.title') %></h2>
      <p class="fr-text--lg"><%= t('.simplifions.description').html_safe %></p>
      <div class="fr-grid-row fr-grid-row--gutters fr-mt-2w">
        <% @cas_usages.each do |use_case| %>
          <div class="fr-col-12 fr-col-sm-6 fr-col-md-4">
            <%= render 'shared/cas_usages/simplifions_card', use_case: %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
