<% content_for(:page_title, t('.page_title')) %>

<div class="fr-grid-row fr-grid-row--center">
  <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
    <h1><%= t('.title') %></h1>

    <p><%= t('.description') %></p>

    <%= form_with url: api_particulier_facilitators_path, method: :post, data: { turbo: false } do |f| %>
      <div class="fr-input-group<%= ' fr-input-group--error' if @error %>">
        <%= f.label :password, t('.password'), class: 'fr-label' %>
        <%= f.password_field :password,
              class: ['fr-input', ('fr-input--error' if @error)],
              required: true,
              autocomplete: 'current-password',
              aria: ({ describedby: 'facilitators-password-error' } if @error) %>
        <% if @error %>
          <p id="facilitators-password-error" class="fr-error-text"><%= t(".errors.#{@error}") %></p>
        <% end %>
      </div>

      <%= f.submit t('.submit'), class: 'fr-btn' %>
    <% end %>
  </div>
</div>
