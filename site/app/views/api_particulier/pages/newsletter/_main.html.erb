<section id="section-newsletter" class="fr-background-default-white fr-pt-6w">
  <div class="fr-container">
    <div class="fr-grid-row">
      <%= render 'shared/newsletter/subscription_form' %>
      <div class="fr-col-xs-12 fr-col-sm-12 fr-col-md-5 fr-col-lg-5 fr-col-xl-5 fr-col-offset-md-1 fr-col-offset-lg-1 fr-col-offset-xl-1">
        <h3 class="fr-h4"><%= t('.operations_title').html_safe %></h3>
        <p><%= t('.operations_description').html_safe %></p>
        <%= external_link_to t('.operations_button'), 'https://status.particulier.api.gouv.fr/subscribe/email', class: 'fr-btn fr-btn--secondary fr-mb-8v' %>

        <h3 class="fr-h4"><%= t('.changelog_title').html_safe %></h3>
        <p><%= t('.changelog_description').html_safe %></p>
        <a href="<%= changelogs_path %>" class="fr-btn fr-btn--secondary fr-mb-8v"><%= t('.changelog_button') %></a>
      </div>
    </div>
  </div>
</section>
