<div class="fr-grid-row">
  <div class="fr-col-12 fr-col-md-8">
    <%= render 'header', title: 'Ce compte ne correspond pas' %>

    <div class="fr-alert fr-alert--error fr-mb-4w">
      <h2 class="fr-alert__title">Vous êtes identifié(e) avec <%= current_user.email %></h2>
      <p>
        <% if @batch.contact_email.present? %>
          Ces demandes ont été préparées pour <%= @batch.masked_contact_email %>.
        <% else %>
          <%= @batch.editor.name.strip %> ne nous a pas transmis l'adresse électronique du demandeur de ces demandes.
        <% end %>
        Identifiez-vous avec ce compte, ou demandez à <%= @batch.editor.name.strip %> de corriger l'adresse.
      </p>
    </div>

    <%= link_to 'Se connecter avec un autre compte', logout_path, class: %w(fr-btn fr-btn--secondary) %>
  </div>
</div>
