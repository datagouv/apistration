<% count = @batch.pending_requests.size %>
<% editor_name = @batch.editor.name.strip %>
<div class="fr-grid-row">
  <div class="fr-col-12 fr-col-md-8">
    <%= render 'header', title: count > 1 ? "Vos #{count} habilitations DataPass" : 'Votre habilitation DataPass' %>

    <%= delegation_stepper(0) %>

    <p>
      <%= editor_name %> interroge l’<%= delegation_api_name(@batch) %> pour le compte de <%= @batch.organizations.size > 1 ? 'vos organisations' : 'votre organisation' %>.
      <% if count > 1 %>
        Chacun de vos <strong><%= count %> établissements</strong> doit pour cela disposer d’une habilitation DataPass&nbsp;: nous les avons préparées.
      <% else %>
        Votre organisation doit pour cela disposer d’une habilitation DataPass&nbsp;: nous l’avons préparée.
      <% end %>
    </p>

    <%= render 'legal_frame' %>

    <h2 class="fr-h5">Comment ça se passe&nbsp;?</h2>
    <ol>
      <li>Identifiez-vous avec ProConnect.</li>
      <li>Complétez ou vérifiez le délégué à la protection des données (DPD)&nbsp;: nous avons déjà le reste.</li>
      <li>Vérifiez le résumé, puis soumettez.</li>
    </ol>
    <p class="fr-text--sm">Vous soumettez au nom de votre organisation, et non en votre nom propre.</p>

    <% if @batch.contact_email.blank? %>
      <div class="fr-alert fr-alert--warning">
        <p>
          <%= editor_name %> ne nous a pas transmis l'adresse électronique du demandeur de cette demande.
          Demandez-lui de la compléter&nbsp;: vous recevrez alors un nouveau lien.
        </p>
      </div>
    <% else %>
      <div class="fr-alert fr-alert--info fr-alert--sm fr-mb-3w">
        <p>Identifiez-vous avec le compte ProConnect de <strong><%= @batch.masked_contact_email %></strong>.</p>
      </div>

      <div class="fr-connect-group">
        <%= form_with(url: proconnect_login_path(@batch), method: :post, data: { turbo: false }) do |f| %>
          <%= f.button class: %w(fr-connect fr-connect-proconnect), id: 'login_pro_connect' do %>
            <span class="fr-connect__login">S’identifier avec</span>
            <span class="fr-connect__brand">ProConnect</span>
          <% end %>
        <% end %>
        <p>
          <%= external_link_to 'https://www.proconnect.gouv.fr/' do %>Qu’est-ce que ProConnect ?<% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>
