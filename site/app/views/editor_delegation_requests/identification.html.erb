<% count = @batch.pending_requests.size %>
<div class="fr-grid-row">
  <div class="fr-col-12 fr-col-md-8">
    <% if count > 1 %>
      <%= render 'header', title: "#{count} demandes d'habilitation à soumettre" %>
      <p>
        Vos administrations utilisent la solution <%= @batch.editor.name.strip %>, qui interroge l'<%= delegation_api_name(@batch) %> pour
        récupérer à leur place <%= delegation_data_subject(@batch) %>. Leur consultation suppose une habilitation&nbsp;: nous
        avons préparé une demande pour chacun de vos <strong><%= count %> établissements</strong>. Vous pouvez toutes les
        soumettre en une seule fois.
      </p>
    <% else %>
      <%= render 'header', title: 'Une habilitation pour votre administration' %>
      <p>
        Votre administration utilise la solution <%= @batch.editor.name.strip %>, qui interroge l'<%= delegation_api_name(@batch) %> pour
        récupérer à votre place <%= delegation_data_subject(@batch) %>. Leur consultation suppose une habilitation délivrée à
        votre administration&nbsp;: nous avons préparé la demande, il vous reste à la soumettre.
      </p>
    <% end %>

    <div class="fr-callout fr-mb-4w">
      <p class="fr-callout__text">
        Vous soumettez la demande pour le compte de votre administration, et non en votre nom propre. L'habilitation est délivrée à la
        personne morale que vous représentez&nbsp;; vous en êtes le demandeur.
      </p>
    </div>

    <% if @batch.contact_email.blank? %>
      <div class="fr-alert fr-alert--warning">
        <p>
          <%= @batch.editor.name.strip %> ne nous a pas transmis l'adresse électronique du demandeur de cette demande.
          Demandez-lui de la compléter&nbsp;: vous recevrez alors un nouveau lien.
        </p>
      </div>
    <% else %>
      <h2>S'identifier</h2>
      <div class="fr-alert fr-alert--info fr-alert--sm fr-mb-3w">
        <p>
          Identifiez-vous avec le compte ProConnect de <strong><%= @batch.masked_contact_email %></strong>, l'adresse que
          nous a transmise <%= @batch.editor.name.strip %>.
        </p>
      </div>

      <div class="fr-connect-group">
        <%= form_with(url: proconnect_login_path(@batch), method: :post, data: { turbo: false }) do |f| %>
          <%= f.button class: %w(fr-connect fr-connect-proconnect), id: 'login_pro_connect' do %>
            <span class="fr-connect__login">S’identifier avec</span>
            <span class="fr-connect__brand">ProConnect</span>
          <% end %>
        <% end %>
        <p>
          <%= external_link_to 'https://www.proconnect.gouv.fr/' do %>Qu’est-ce que ProConnect ?<% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>
