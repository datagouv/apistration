<div class="fr-grid-row fr-grid-row--gutters">
  <div class="fr-col-12">
    <h1>Vue générale des utilisateurs</h1>

    <%= render 'admin/statistics/filter', filter: @filter, show_dates: false, show_interval: false, show_status: true %>

    <div class="fr-grid-row fr-grid-row--gutters fr-mb-2w">
      <%= render 'shared/dsfr_chart/kpi', label: 'Utilisateurs au total', value: number_with_delimiter(@query.total_users) %>
      <%= render 'shared/dsfr_chart/kpi', label: 'Habilitations au total', value: number_with_delimiter(@query.total_habilitations) %>
      <%= render 'shared/dsfr_chart/kpi', label: 'Jetons au total', value: number_with_delimiter(@query.total_tokens) %>
    </div>

    <div class="fr-grid-row fr-grid-row--gutters">
      <%= render 'shared/dsfr_chart/kpi',
        label: 'Habilitations ayant passé au moins 1 appel réussi (18 derniers mois, domaine seul)',
        value: number_with_delimiter(@query.habilitations_with_successful_call) %>
    </div>
  </div>
</div>
