<%# locals: (filter:, show_dates: true, show_date_to: true, show_domaine: true, show_interval: true, show_api: false, show_email: false, show_external_id: false, show_demarche: false, show_token: false, show_france_connect: false, show_status: false) -%>
<%= form_with model: filter, scope: :filter, method: :get, url: request.path, local: true, class: 'fr-mb-3w' do |f| %>
  <% if show_dates && show_date_to %>
    <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--sm fr-mb-2w">
      <% Admin::StatisticsFilter.date_presets.each do |key, (from, to)| %>
        <li>
          <%= link_to key,
                      url_for(request.query_parameters.deep_merge(filter: { date_from: from.iso8601, date_to: to.iso8601 })),
                      class: "fr-btn fr-btn--sm #{'fr-btn--secondary' unless filter.matches_preset?(key)}".strip %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="fr-grid-row fr-grid-row--gutters">
    <% if show_dates %>
      <div class="fr-col-12 fr-col-md-3">
        <div class="fr-input-group">
          <%= f.label :date_from, show_date_to ? 'Date de début' : 'Depuis le', class: 'fr-label' %>
          <%= f.date_field :date_from, class: 'fr-input' %>
        </div>
      </div>
      <% if show_date_to %>
        <div class="fr-col-12 fr-col-md-3">
          <div class="fr-input-group">
            <%= f.label :date_to, 'Date de fin', class: 'fr-label' %>
            <%= f.date_field :date_to, class: 'fr-input' %>
          </div>
        </div>
      <% end %>
    <% end %>
    <% if show_interval %>
      <div class="fr-col-12 fr-col-md-2">
        <div class="fr-select-group">
          <%= f.label :interval, 'Découpage', class: 'fr-label' %>
          <%= f.select :interval, Admin::StatisticsFilter::INTERVALS.map { |i| [i.capitalize, i] }, {}, class: 'fr-select' %>
        </div>
      </div>
    <% end %>
    <% if show_domaine %>
      <div class="fr-col-12 fr-col-md-2">
        <div class="fr-select-group">
          <%= f.label :domaine, 'Domaine', class: 'fr-label' %>
          <%= f.select :domaine, [['Tous', ''], ['Entreprise', 'entreprise'], ['Particulier', 'particulier']], {}, class: 'fr-select' %>
        </div>
      </div>
    <% end %>
    <% if show_api %>
      <div class="fr-col-12 fr-col-md-4">
        <div class="fr-select-group">
          <%= f.label :api, 'API (controller)', class: 'fr-label' %>
          <%= f.select :api, statistics_controller_options(filter), { include_blank: 'Toutes' }, class: 'fr-select' %>
        </div>
      </div>
    <% end %>
    <% if show_email %>
      <div class="fr-col-12 fr-col-md-3">
        <div class="fr-input-group">
          <%= f.label :email, 'Email', class: 'fr-label' %>
          <%= f.email_field :email, class: 'fr-input' %>
        </div>
      </div>
    <% end %>
    <% if show_external_id %>
      <div class="fr-col-12 fr-col-md-3">
        <div class="fr-input-group">
          <%= f.label :external_id, 'Datapass ID', class: 'fr-label' %>
          <%= f.text_field :external_id, class: 'fr-input' %>
        </div>
      </div>
    <% end %>
    <% if show_demarche %>
      <div class="fr-col-12 fr-col-md-3">
        <div class="fr-select-group">
          <%= f.label :demarche, 'Éditeur (démarche)', class: 'fr-label' %>
          <%= f.select :demarche, statistics_demarche_options(filter), { include_blank: 'Tous' }, class: 'fr-select' %>
        </div>
      </div>
    <% end %>
    <% if show_token %>
      <div class="fr-col-12 fr-col-md-4">
        <div class="fr-input-group">
          <%= f.label :token_id, 'Token ID', class: 'fr-label' %>
          <%= f.text_field :token_id, class: 'fr-input' %>
        </div>
      </div>
    <% end %>
    <% if show_france_connect %>
      <div class="fr-col-12 fr-col-md-3">
        <div class="fr-input-group">
          <%= f.label :france_connect_client_id, 'Client FranceConnect', class: 'fr-label' %>
          <%= f.text_field :france_connect_client_id, class: 'fr-input' %>
        </div>
      </div>
    <% end %>
    <% if show_status %>
      <div class="fr-col-12 fr-col-md-3">
        <div class="fr-select-group">
          <%= f.label :status, 'Statut de l\'habilitation', class: 'fr-label' %>
          <%= f.select :status, statistics_status_options, { include_blank: 'Tous' }, class: 'fr-select' %>
        </div>
      </div>
    <% end %>
  </div>

  <ul class="fr-btns-group fr-btns-group--inline-md fr-mt-2w">
    <li><%= f.submit 'Appliquer', class: 'fr-btn', name: nil %></li>
    <li><%= link_to 'Réinitialiser', request.path, class: 'fr-btn fr-btn--secondary' %></li>
  </ul>
<% end %>
