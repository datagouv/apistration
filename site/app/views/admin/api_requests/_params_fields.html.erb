<% if @facade.selected_endpoint.present? %>
  <h2 class="fr-text--lg">Paramètres</h2>
  <% @facade.parameters.each do |param| %>
    <% if param.array? %>
      <%= render 'array_field', param: param %>
    <% else %>
      <%= render 'field', param: param %>
    <% end %>
  <% end %>

  <% if @facade.header_parameters.any? %>
    <h2 class="fr-text--lg fr-mt-4w">En-têtes</h2>
    <% @facade.header_parameters.each do |param| %>
      <%= render 'field', param: param %>
    <% end %>
  <% end %>
<% end %>
