<div class="fr-grid-row fr-grid-row--middle fr-mb-4w">
  <div class="fr-col">
    <h1 class="fr-mb-0">Éditeurs</h1>
  </div>
  <div class="fr-col-auto">
    <%= link_to 'Nouvel éditeur', new_admin_editor_path, class: 'fr-btn' %>
  </div>
</div>

<%= form_with url: admin_editors_path, method: :get, data: { turbo: false }, class: 'fr-mb-4w' do |f| %>
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--bottom">
    <div class="fr-col-8">
      <div class="fr-input-group">
        <%= f.label :search, 'Rechercher par nom ou SIRET', class: 'fr-label' %>
        <%= f.text_field :search, value: params[:search], class: 'fr-input' %>
      </div>
    </div>
    <div class="fr-col-4">
      <%= f.submit 'Filtrer', class: 'fr-btn' %>
    </div>
  </div>
<% end %>

<div class="fr-table fr-table--bordered">
  <table>
    <caption>Éditeurs (<%= @editors.total_count %>)</caption>
    <thead>
      <tr>
        <% ['Éditeur', 'Fiche', 'Démarches', 'Membres', 'Double authentification', 'Déploiement'].each do |header| %>
          <th scope="col"><%= header %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @editors.each do |editor| %>
        <% gaps = EditorProfileGaps.new(editor) %>
        <% use_cases = editor.use_cases.to_a %>
        <tr id="<%= dom_id(editor) %>">
          <td>
            <%= link_to editor.name, admin_editor_path(editor), class: 'fr-link' %>
            <% if editor.siret.present? %>
              <br><%= external_link_to editor.siret, "https://annuaire-entreprises.data.gouv.fr/etablissement/#{editor.siret}", class: 'fr-link fr-link--sm' %>
            <% end %>
          </td>
          <td>
            <% if gaps.any? %>
              <%= link_to admin_editor_path(editor), class: 'fr-badge fr-badge--sm fr-badge--warning', title: gaps.all.map(&:label).join(', ') do %>
                <%= pluralize(gaps.size, 'information manquante', plural: 'informations manquantes') %>
              <% end %>
            <% else %>
              <p class="fr-badge fr-badge--sm fr-badge--success">Complète</p>
            <% end %>
          </td>
          <td>
            <%= use_cases.size %>
            <% with_form = use_cases.count(&:form_uid) %>
            <% if with_form.positive? %>
              <br><span class="fr-text--xs fr-text-mention--grey">dont <%= with_form %> avec formulaire DataPass</span>
            <% end %>
          </td>
          <td><%= @users_counts.fetch(editor.id, 0) %></td>
          <td><%= editor.decorate.two_factor_label %></td>
          <td><%= editor.deployment_type ? editor.decorate.deployment_type_label : tag.span('Non renseigné', class: 'fr-text-mention--grey') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= paginate @editors %>
