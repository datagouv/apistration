<p class="fr-text--sm fr-mb-2w"><%= t('.description') %></p>

<%= button_to t('.generate'), editor_tokens_path, class: 'fr-btn fr-mb-2w' %>

<div class="fr-table fr-table--bordered">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <caption><%= t('.title') %></caption>
          <thead>
            <tr>
              <th scope="col"><%= t('.table.identifier') %></th>
              <th scope="col"><%= t('.table.allowed_ips') %></th>
              <th scope="col"><%= t('.table.created_at') %></th>
              <th scope="col"><%= t('.table.expiration') %></th>
              <th scope="col"><%= t('.table.status') %></th>
            </tr>
          </thead>
          <tbody>
            <% @editor_tokens.each do |editor_token| %>
              <tr id="<%= dom_id(editor_token) %>">
                <td><code><%= editor_token.id.first(8) %>&hellip;</code></td>
                <td><%= editor_token.allowed_ips_as_strings.join(', ').presence || '—' %></td>
                <td><%= l(editor_token.created_at, format: :short) %></td>
                <td><%= friendly_date_from_timestamp(editor_token.exp) %></td>
                <td>
                  <% if editor_token.blacklisted? %>
                    <p class="fr-badge fr-badge--pink-tuile"><%= t('.status_revoked') %></p>
                  <% elsif editor_token.expired? %>
                    <p class="fr-badge"><%= t('.status_expired') %></p>
                  <% else %>
                    <p class="fr-badge fr-badge--green-emeraude"><%= t('.status_active') %></p>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
