<section id="section-other-use-cases" class="other-use-cases">
  <div class="fr-container">
    <div class="fr-grid-row">
      <div class="left-info fr-col-xl-8 fr-col-12 fr-pt-5w padding-left-container">
        <div class="left-info--text">
          <h2 class="fr-h3"><%= t('.title') %></h2>
          <p class="fr-text--lg"><%= t('.description').html_safe %></p>
        </div>
      </div>
    </div>
  </div>
  <div class="fr-container">
    <div id="cas-usages" class="fr-container--fluid">
      <div class="content fr-grid-row fr-grid-row--gutters fr-grid-row--top">
        <div class="fr-col-12 fr-col-sm-6 fr-col-md-4">
          <%= render 'shared/cas_usages/internal_use_case_card',
            title: t('.cards.socle_de_base.title'),
            url: cas_usage_path(uid: 'socle_de_base'),
            description: t('.cards.socle_de_base.description'),
            user_types: @socle_de_base.user_types,
            content_category: @socle_de_base.content_category,
            api: 'api_entreprise',
            uid: 'socle_de_base' %>
        </div>
        <% @cas_usages_sample.each do |use_case| %>
          <div class="fr-col-12 fr-col-sm-6 fr-col-md-4">
            <%= render 'shared/cas_usages/simplifions_card', use_case: %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="fr-container fr-my-5w">
    <div class="fr-grid-row fr-grid-row--center">
      <%= link_to cas_usages_path, class: 'fr-btn' do %>
        <%= t('.link') %>&nbsp;<span class="fr-icon-arrow-right-line" aria-hidden="true"></span>
      <% end %>
    </div>
  </div>
</section>
