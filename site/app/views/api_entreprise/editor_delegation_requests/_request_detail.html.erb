<% data = @batch.datapass_data %>
<%= render layout: 'section', locals: { title: 'Le projet' } do %>
  <%= render 'value', label: 'Nom du projet', value: data['intitule'] %>
  <%= render 'value', label: 'Description du projet', value: data['description'] %>
  <%= render 'value', label: 'Destinataires des données', value: data['destinataire_donnees_caractere_personnel'] %>
  <%= render 'value', label: 'Durée de conservation des données en mois', value: data['duree_conservation_donnees_caractere_personnel'] %>
<% end %>

<%= render layout: 'section', locals: { title: 'Le cadre juridique' } do %>
  <%= render 'value', label: 'Nature et références du texte vous autorisant à traiter les données', value: data['cadre_juridique_nature'] %>
  <% if data['cadre_juridique_url'].present? %>
    <p class="fr-text--bold fr-mb-1v">Lien relatif au traitement</p>
    <p><%= external_link_to data['cadre_juridique_url'], data['cadre_juridique_url'] %></p>
  <% end %>
<% end %>

<%= render layout: 'section', locals: { title: 'Les données' } do %>
  <ul>
    <% DatapassScopes.normalize(Array(data['scopes'])).each do |scope| %>
      <li><%= t("api_entreprise.tokens.token.scope.#{scope}.label", default: scope) %></li>
    <% end %>
  </ul>
<% end %>

<%= render layout: 'section', locals: { title: "Les contacts de #{@batch.editor.name.strip}" } do %>
  <div class="fr-grid-row fr-grid-row--gutters">
    <%= render 'contact', data:, kind: 'contact_metier', label: 'Contact métier' %>
    <%= render 'contact', data:, kind: 'contact_technique', label: 'Contact technique' %>
  </div>
<% end %>
