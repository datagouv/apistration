<% single = @batch.single? %>
<% count = @batch.pending_requests.size %>
<% organizations_count = @batch.organizations.size %>
<% lead_request = @batch.pending_requests.first %>
<div class="fr-grid-row">
  <div class="fr-col-12 fr-col-lg-10">
    <% if single %>
      <%= render 'header', title: "Signez la demande de #{@batch.organizations.first.name}" %>
      <p>
        Identifié(e) en tant que <%= current_user.full_name %> (<%= current_user.email %>)
        · SIRET <%= lead_request.siret %>
      </p>
    <% else %>
      <%= render 'header', title: "Signer vos #{count} demandes" %>
      <div class="fr-grid-row fr-grid-row--gutters fr-mb-3w">
        <%= render 'shared/dsfr_chart/kpi', value: count, label: 'établissements' %>
        <%= render 'shared/dsfr_chart/kpi', value: organizations_count, label: 'organisations' %>
        <%= render 'shared/dsfr_chart/kpi', value: "#{organizations_count - @batch.organizations_without_data_protection_officer.size} / #{organizations_count}", label: 'délégués à la protection des données renseignés' %>
      </div>
    <% end %>

    <%= form_with(model: @signature, scope: :signature, url: editor_delegation_request_signature_path, method: :post, data: { controller: 'batch-selection' }) do |f| %>
      <% if @signature.errors[:base].any? %>
        <div class="fr-alert fr-alert--error fr-mb-4w">
          <% @signature.errors[:base].each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <% if @batch.data_protection_officer_shared_form? %>
        <h2 class="fr-h4"><%= organizations_count > 1 ? "Le délégué à la protection des données de vos #{organizations_count} organisations" : 'Votre délégué à la protection des données' %></h2>
        <p>
          Il est le point de contact sur le traitement des données personnelles rendu possible par cette habilitation.
          Il doit être informé de votre demande.
        </p>
        <%= f.fields_for :data_protection_officer, @signature.data_protection_officer_form do |officer| %>
          <%= render 'data_protection_officer_fields', form: officer %>
        <% end %>
        <% if organizations_count > 1 %>
          <p><%= link_to 'Renseigner un délégué différent selon l’organisation', editor_delegation_request_organizations_path, class: 'fr-link' %></p>
        <% end %>
      <% else %>
        <%= render 'data_protection_officer_summary' %>
      <% end %>

      <div class="fr-accordions-group fr-mt-4w fr-mb-4w">
        <% unless single %>
          <%= render layout: 'accordion', locals: { id: 'establishments', title: @batch.small? ? "Vos #{count} établissements" : 'Exclure des établissements', expanded: @batch.small? } do %>
            <%= render 'establishments' %>
          <% end %>
        <% end %>
        <%= render layout: 'accordion', locals: { id: 'request-detail', title: 'Ce que vous signez' } do %>
          <%= render 'request_detail' %>
        <% end %>
      </div>

      <% if @signature.errors[:included_ids].any? %>
        <p class="fr-error-text fr-mb-2w">Cochez au moins un établissement pour signer.</p>
      <% end %>

      <% { terms_of_service_accepted: "J'ai pris connaissance des #{external_link_to('conditions générales d’utilisation', cgu_path)} et je les valide.",
           data_protection_officer_informed: "Je confirme que le délégué à la protection des données #{organizations_count > 1 ? 'de mes organisations' : 'de mon organisation'} est informé de ma demande." }.each do |attribute, label| %>
        <% errors = @signature.errors[attribute] %>
        <div class="fr-checkbox-group fr-mb-2w <%= 'fr-checkbox-group--error' if errors.any? %>">
          <%= f.check_box attribute, { id: attribute, checked: @signature.public_send(attribute) }, '1', '0' %>
          <%= f.label attribute, tag.span(sanitize(label, tags: %w[a span], attributes: %w[href target rel class])), for: attribute, class: 'fr-label' %>
          <% if errors.any? %>
            <p class="fr-error-text">Vous devez cocher cette case pour signer.</p>
          <% end %>
        </div>
      <% end %>

      <p class="fr-text--sm">
        En signant, vous acceptez que votre identité ProConnect, la date et l'heure soient consignées comme preuve de
        votre accord.
      </p>

      <ul class="fr-btns-group fr-btns-group--inline-md fr-btns-group--right">
        <li>
          <%= f.button single ? 'Signer la demande' : "Signer les #{count} demandes", class: 'fr-btn', data: { batch_selection_target: 'submit' } %>
        </li>
      </ul>
    <% end %>
  </div>
</div>
