<turbo-frame id="provider_pings">
  <% if @pings.nil? %>
    <%= render 'shared/provider_pings/unavailable' %>
  <% else %>
    <%= render 'shared/provider_pings/summary', pings: @pings, checks: @checks %>
    <%= render 'shared/provider_pings/table', pings: @pings, checks: @checks %>
    <% if provider_pings_pending?(@pings, @checks) %>
      <div data-controller="frame-reload"></div>
    <% end %>
  <% end %>
</turbo-frame>
