<%= turbo_frame_tag "stats_#{@query.period}" do %>
  <section class="fr-mt-4w">
    <h2 class="fr-mb-3w"><%= t(".title.#{@query.period}") %></h2>

    <% if @indicators %>
      <%= render 'shared/stats/indicators', api: @query.api, period: @query.period, indicators: @indicators %>
    <% else %>
      <p class="fr-text--sm"><%= t('.pending') %></p>
    <% end %>
  </section>
<% end %>
