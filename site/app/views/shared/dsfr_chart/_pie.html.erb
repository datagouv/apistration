<%# locals: (title:, slices:) -%>
<figure class="fr-mb-3w">
  <figcaption class="fr-text--lead"><%= title %></figcaption>
  <pie-chart
    x="<%= [slices.keys].to_json %>"
    y="<%= [slices.values].to_json %>"
    name="<%= slices.keys.to_json %>"
    fill="true"
    aspect-ratio="3">
  </pie-chart>
</figure>
