<%# locals: (title:, categories:, series:, unit: nil, palette: nil, stacked: false, downloadable: true) -%>
<%# Each series: { label:, values: [...] } aligned with categories. -%>
<%
  x = [categories.map(&:to_s)]
  y = series.map { |s| s[:values] }
  names = series.map { |s| s[:label] }
%>
<figure class="fr-mb-3w" data-controller="chart-download" data-chart-download-title-value="<%= title %>">
  <%= render 'shared/dsfr_chart/header', title: title, downloadable: downloadable %>
  <div data-chart-download-target="chart">
    <bar-chart
      x="<%= x.to_json %>"
      y="<%= y.to_json %>"
      name="<%= names.to_json %>"
      <% if unit %>unit-tooltip="<%= unit %>"<% end %>
      <% if palette %>selected-palette="<%= palette %>"<% end %>
      <%= 'stacked="true"' if stacked %>>
    </bar-chart>
  </div>
</figure>
