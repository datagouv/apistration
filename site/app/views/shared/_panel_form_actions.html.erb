<ul class="fr-btns-group fr-btns-group--inline-sm">
  <li><%= form.button submit, class: 'fr-btn' %></li>
  <li>
    <% if modal %>
      <button type="button" class="fr-btn fr-btn--secondary" aria-controls="main-modal"><%= cancel %></button>
    <% else %>
      <%= link_to cancel, cancel_path, class: 'fr-btn fr-btn--secondary' %>
    <% end %>
  </li>
</ul>
