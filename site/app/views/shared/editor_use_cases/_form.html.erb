<% scope_groups = use_case.scope_groups %>
<%= form_with(model: use_case, url: use_case.persisted? ? editor_profile_use_case_path(editor, use_case, admin:) : editor_profile_use_cases_path(editor, admin:), method: use_case.persisted? ? :patch : :post) do |f| %>
  <%= f.hidden_field :use_case %>
  <%= editor_profile_readonly("Cas d'usage DataPass", use_case.label) %>
  <% unless use_case.persisted? %>
    <p class="fr-text--sm"><%= link_to "Choisir un autre cas d'usage", editor_profile_new_use_case_path(editor, admin:), class: 'fr-link' %></p>
  <% end %>

  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col-12 fr-col-md-6">
      <%= editor_profile_field(f, :text_field, :software, 'Logiciel', hint: 'Le logiciel qui implémente ce cas d’usage') %>
    </div>
    <div class="fr-col-12 fr-col-md-6">
      <%= editor_profile_select(f, :integration_status, "Statut d'intégration", EditorUseCase.integration_status_options) %>
    </div>
  </div>

  <h2 class="fr-h5 fr-mt-4w">Données utilisées</h2>
  <p class="fr-text--sm">Les données pré-cochées sont celles du formulaire DataPass de ce cas d'usage : décochez celles que votre logiciel n'utilise pas.</p>
  <% if scope_groups.any? %>
    <%= hidden_field_tag 'editor_use_case[scopes][]', '', id: nil %>
    <% scope_groups.each do |group, options| %>
      <fieldset class="editor-scopes-group fr-mb-3w">
        <legend class="editor-scopes-group__title"><%= group %></legend>
        <div class="editor-scopes-group__grid">
          <% options.each do |label, value| %>
            <% input_id = "editor_use_case_scopes_#{value}" %>
            <div class="fr-checkbox-group">
              <%= check_box_tag 'editor_use_case[scopes][]', value, use_case.scopes.include?(value), id: input_id %>
              <%= label_tag input_id, label, class: 'fr-label' %>
            </div>
          <% end %>
        </div>
      </fieldset>
    <% end %>
  <% else %>
    <% use_case.scopes.each do |scope| %>
      <%= hidden_field_tag 'editor_use_case[scopes][]', scope, id: nil %>
    <% end %>
    <div class="fr-alert fr-alert--warning fr-alert--sm fr-mb-3w">
      <p>La liste des données DataPass n'est pas disponible pour le moment : les données déjà cochées sont conservées.</p>
    </div>
  <% end %>

  <h2 class="fr-h5 fr-mt-4w">Données personnelles</h2>
  <%= editor_profile_row do %>
    <%= editor_profile_field(f, :text_field, :data_recipients, 'Destinataires des données', hint: 'Par exemple : agents du service enfance de la collectivité') %>
  <% end %>
  <%= editor_profile_row(width: 3) do %>
    <%= editor_profile_field(f, :number_field, :data_retention_months, 'Durée de conservation', hint: 'En mois, par exemple 36', min: 1) %>
  <% end %>

  <h2 class="fr-h5 fr-mt-4w">Configuration du jeton</h2>
  <%= editor_profile_row do %>
    <%= editor_profile_field(f, :text_area, :setup_instructions, 'Instructions de configuration du jeton', hint: 'Comment vos clients renseignent leur jeton dans ce logiciel', rows: 5) %>
  <% end %>

  <% if admin %>
    <h2 class="fr-h5 fr-mt-4w">Rattachement DataPass</h2>
    <%= editor_profile_row do %>
      <%= editor_profile_field(f, :text_field, :form_uid, 'Formulaire DataPass', hint: "Identifiant du formulaire. Les habilitations validées avec ce formulaire sont déléguées automatiquement à l'éditeur.") %>
    <% end %>
  <% elsif use_case.form_uid %>
    <%= editor_profile_readonly('Formulaire DataPass', tag.code(use_case.form_uid)) %>
  <% end %>

  <div class="fr-btns-group fr-btns-group--inline fr-mt-2w">
    <%= f.submit 'Enregistrer', class: 'fr-btn' %>
    <%= link_to 'Annuler', back_path, class: 'fr-btn fr-btn--secondary' %>
  </div>
<% end %>
