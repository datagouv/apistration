<% gaps = EditorProfileGaps.new(editor) %>
<%= render 'shared/editor_profile/gaps', editor:, gaps:, admin: %>
<div class="fr-tabs fr-mt-4w" data-controller="permalink-tabs" data-permalink-tabs-param-value="onglet">
  <ul class="fr-tabs__list" role="tablist" aria-label="Fiche éditeur">
    <% EditorProfileSection.all.each do |section| %>
      <li role="presentation">
        <button id="editor-profile-<%= section.key %>" class="fr-tabs__tab" tabindex="<%= section == current_section ? '0' : '-1' %>" role="tab" aria-selected="<%= section == current_section %>" aria-controls="editor-profile-<%= section.key %>-panel" data-tab-key="<%= section.key %>" data-action="click->permalink-tabs#select">
          <%= section.label %>
          <% section_gaps = gaps.for_section(section.key).size %>
          <% if section_gaps.positive? %>
            <span class="fr-badge fr-badge--sm fr-badge--warning fr-badge--no-icon fr-ml-1w"><%= section_gaps %><span class="fr-sr-only"> à compléter</span></span>
          <% end %>
        </button>
      </li>
    <% end %>
  </ul>
  <% EditorProfileSection.all.each do |section| %>
    <div id="editor-profile-<%= section.key %>-panel" class="fr-tabs__panel <%= 'fr-tabs__panel--selected' if section == current_section %>" role="tabpanel" aria-labelledby="editor-profile-<%= section.key %>" tabindex="0">
      <%= render "shared/editor_profile/#{section.key}", editor:, section:, admin: %>
    </div>
  <% end %>
</div>
