<%= form_with(model: editor, url: editor_profile_path_for(editor, section.key, admin:), method: :patch) do |f| %>
  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col-12 fr-col-md-6">
      <%= editor_profile_input_group(f, :contact_email, 'Email') do %>
        <%= f.email_field :contact_email, class: 'fr-input' %>
      <% end %>
    </div>
    <div class="fr-col-12 fr-col-md-6">
      <%= editor_profile_input_group(f, :contact_phone, 'Téléphone') do %>
        <%= f.telephone_field :contact_phone, class: 'fr-input' %>
      <% end %>
    </div>
  </div>

  <%= f.submit 'Enregistrer', class: 'fr-btn' %>
<% end %>

<% if admin %>
  <%= render 'admin/editors/members', editor: %>
<% end %>
