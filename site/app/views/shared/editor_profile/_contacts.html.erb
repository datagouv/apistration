<% contacts = editor.contacts.by_role %>
<h2 class="fr-h4">Contacts de l'éditeur</h2>
<p class="fr-text--sm">Les personnes que nos équipes contactent selon le sujet. Plusieurs contacts par rôle sont possibles.</p>

<% if contacts.any? %>
  <div class="fr-table fr-table--no-caption">
    <div class="fr-table__wrapper">
      <div class="fr-table__container">
        <div class="fr-table__content">
          <table>
            <caption>Contacts de l'éditeur</caption>
            <thead>
              <tr>
                <th scope="col">Rôle</th>
                <th scope="col">Nom</th>
                <th scope="col">Email</th>
                <th scope="col">Téléphone</th>
                <th scope="col"><span class="fr-sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% contacts.each do |contact| %>
                <tr id="<%= dom_id(contact) %>">
                  <td><%= contact.role_label %></td>
                  <td><%= contact.full_name.presence || editor_profile_blank %></td>
                  <td><%= contact.email ? mail_to(contact.email, class: 'fr-link') : editor_profile_blank %></td>
                  <td><%= contact.phone.presence || editor_profile_blank %></td>
                  <td>
                    <%= button_to 'Retirer', editor_profile_contact_path(editor, contact, admin:),
                          method: :delete,
                          class: 'fr-btn fr-btn--sm fr-btn--tertiary',
                          data: { turbo_confirm: 'Retirer ce contact ?' } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <p class="fr-text--sm fr-text-mention--grey">Aucun contact renseigné.</p>
<% end %>

<h3 class="fr-h5 fr-mt-4w">Ajouter un contact</h3>
<%= form_with(model: EditorContact.new, url: editor_profile_contacts_path(editor, admin:), method: :post) do |f| %>
  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col-12 fr-col-md-3">
      <div class="fr-select-group">
        <%= f.label :role, 'Rôle', class: 'fr-label' %>
        <%= f.select :role, EditorContact.role_options, {}, class: 'fr-select' %>
      </div>
    </div>
    <div class="fr-col-12 fr-col-md-3">
      <%= editor_profile_input_group(f, :full_name, 'Nom') do %>
        <%= f.text_field :full_name, class: 'fr-input' %>
      <% end %>
    </div>
    <div class="fr-col-12 fr-col-md-3">
      <%= editor_profile_input_group(f, :email, 'Email') do %>
        <%= f.email_field :email, class: 'fr-input' %>
      <% end %>
    </div>
    <div class="fr-col-12 fr-col-md-3">
      <%= editor_profile_input_group(f, :phone, 'Téléphone') do %>
        <%= f.telephone_field :phone, class: 'fr-input' %>
      <% end %>
    </div>
  </div>

  <%= f.submit 'Ajouter le contact', class: 'fr-btn fr-btn--secondary' %>
<% end %>

<% if admin %>
  <%= render 'admin/editors/members', editor: %>
<% end %>
