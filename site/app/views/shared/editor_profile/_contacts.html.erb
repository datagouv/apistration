<% contacts = editor.contacts.by_role %>
<h2 class="fr-h4">Contacts de l'éditeur</h2>
<p class="fr-text--sm">Les personnes que nos équipes contactent selon le sujet. Plusieurs contacts par rôle sont possibles.</p>

<% if contacts.any? %>
  <div class="fr-table fr-table--no-caption">
    <div class="fr-table__wrapper">
      <div class="fr-table__container">
        <div class="fr-table__content">
          <table>
            <caption>Contacts de l'éditeur</caption>
            <thead>
              <tr>
                <th scope="col">Rôle</th>
                <th scope="col">Nom</th>
                <th scope="col">Email</th>
                <th scope="col">Téléphone</th>
                <th scope="col"><span class="fr-sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% contacts.each do |contact| %>
                <tr id="<%= dom_id(contact) %>">
                  <td><%= contact.role_label %></td>
                  <td><%= contact.full_name.presence || editor_profile_blank %></td>
                  <td><%= contact.email ? mail_to(contact.email, class: 'fr-link') : editor_profile_blank %></td>
                  <td><%= contact.phone.presence || editor_profile_blank %></td>
                  <td>
                    <% subject = "le contact #{contact.role_label} #{contact.full_name || contact.email || contact.phone}" %>
                    <div class="fr-btns-group fr-btns-group--inline fr-btns-group--sm">
                      <%= editor_profile_edit_link(editor_profile_edit_contact_path(editor, contact, admin:), subject) %>
                      <%= editor_profile_remove_button(editor_profile_contact_path(editor, contact, admin:), subject, 'Retirer ce contact ?') %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <p class="fr-text--sm fr-text-mention--grey">Aucun contact renseigné.</p>
<% end %>

<h3 class="fr-h5 fr-mt-4w">Ajouter un contact</h3>
<%= render 'shared/editor_contacts/form', editor:, contact: EditorContact.new, admin: %>

<% if admin %>
  <%= render 'admin/editors/members', editor: %>
<% end %>
