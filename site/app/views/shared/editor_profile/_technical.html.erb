<%= form_with(model: editor, url: editor_profile_path_for(editor, section.key, admin:), method: :patch) do |f| %>
  <%= editor_profile_field(f, :text_field, :languages, 'Langages utilisés', hint: 'Pour adapter notre documentation technique') %>

  <%= editor_profile_field(f, :text_area, :setup_instructions, 'Instructions de configuration du jeton', hint: 'Comment vos clients renseignent leur jeton dans votre logiciel', rows: 5) %>

  <% if admin %>
    <div class="fr-grid-row fr-grid-row--gutters fr-mb-3w">
      <% { copy_token: 'Peut copier les jetons de ses clients', editor_tokens_enabled: 'Jetons éditeurs activés' }.each do |attribute, label| %>
        <div class="fr-col-12 fr-col-md-6"><%= editor_profile_checkbox(f, attribute, label) %></div>
      <% end %>
    </div>
  <% end %>

  <%= f.submit 'Enregistrer', class: 'fr-btn' %>
<% end %>

<h2 class="fr-h4 fr-mt-6w">Jeton éditeur</h2>
<% active_tokens = editor.tokens.select(&:active?) %>
<% if !editor.editor_tokens_enabled? %>
  <p><span class="fr-badge fr-badge--grey">Non activé</span></p>
  <p class="fr-text--sm">Le jeton éditeur vous permet d'appeler l'API pour tous vos clients avec un seul jeton.</p>
<% elsif active_tokens.any? %>
  <p><span class="fr-badge fr-badge--success">Actif</span> <%= pluralize(active_tokens.size, 'jeton valide', plural: 'jetons valides') %></p>
<% else %>
  <p><span class="fr-badge fr-badge--warning">Activé, aucun jeton valide</span></p>
<% end %>

<% if admin %>
  <%= render 'admin/editors/editor_tokens', editor: %>
<% elsif editor.editor_tokens_enabled? %>
  <%= link_to 'Gérer vos jetons éditeur', editor_tokens_path, class: 'fr-link fr-icon-arrow-right-line fr-link--icon-right' %>
<% end %>
