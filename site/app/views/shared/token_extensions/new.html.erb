<% content_for :page_title, t('.page_title') %>
<turbo-frame id="main-modal-content">
  <div class="single-page">
    <%= form_with model: @token, url: token_extend_path(id: @token.id), method: :post, id: dom_id(@token, :extension), data: { turbo: false } do |form| %>
      <h1 id="<%= dom_id(@token, :extension_title) %>" class="fr-modal__title">
        <span class="fr-icon-time-line fr-icon--lg" aria-hidden="true"></span>
        <%= t('.title', name: @token.name) %>
      </h1>

      <p><%= t('.description', date: friendly_format_from_timestamp(@token.exp)) %></p>

      <div class="fr-alert fr-alert--info fr-alert--sm fr-mb-3w">
        <p>
          <%= t('.check_authorization_request') %>
          <%= external_link_to t('.datapass_link', external_id: @token.authorization_request.external_id), datapass_authorization_request_url(@token.authorization_request), class: 'fr-link' %>
        </p>
      </div>

      <div class="fr-select-group">
        <%= form.label :lifetime_in_months, class: 'fr-label' do %>
          <%= t('.lifetime.label') %>
          <span class="fr-hint-text"><%= t('.lifetime.hint', date: friendly_format_from_timestamp(@token.exp)) %></span>
        <% end %>
        <%= form.select :lifetime_in_months,
          Token::LIFETIMES_IN_MONTHS.map { |months| [t('shared.self_service_tokens.new.lifetime.option', count: months), months] },
          { selected: Token::LIFETIMES_IN_MONTHS.max },
          class: 'fr-select' %>
      </div>

      <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg">
        <li><%= form.button t('.submit'), class: 'fr-btn' %></li>
        <li><button type="button" class="fr-btn fr-btn--secondary" aria-controls="main-modal"><%= t('.cancel') %></button></li>
      </ul>
    <% end %>
  </div>
</turbo-frame>
