<h1>Plan du site</h1>

<% @sitemap_sections.each do |section| %>
  <section>
    <h2><%= section['section'] %></h2>
    <ul>
      <% section['pages'].each do |page| %>
        <li>
          <%= link_to page['title'], public_send("#{page['route']}_path") %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
