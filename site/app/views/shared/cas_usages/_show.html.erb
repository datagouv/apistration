<div id="cas-usage" class="fr-container--fluid">
  <div class="banner"></div>

  <div class="fr-container doc_markdown_to_html" data-controller="anchor-buttons" data-anchor-buttons-tags-value='["h2", "h3", "h4", "section"]'>
    <section class="introduction fr-grid-row fr-background-default-white">
      <div class="introduction_image fr-col-xs-12 fr-col-sm-12 fr-col-md-12 fr-col-lg-2 fr-col-xl-2">
        <%= image_tag("#{api}/cas_usages/pictos/#{params[:uid]}.svg", alt: "") %>
      </div>
      <div class="introduction_text fr-col-xs-12 fr-col-sm-12 fr-col-md-12 fr-col-lg-10 fr-col-xl-10">
        <p class="introduction_text--label"><%= t('.label') %></p>
        <h1 class="fr-h2 introduction_text--title fr-mt-1v"><%= @fiche_pratique.introduction[:title] %></h1>
        <div class="introduction_text--content"><%= markdown_to_html(@fiche_pratique.introduction[:content]) %></div>
        <div class="introduction_text--links">
          <%= link_to t('.link_access'), anchor: 'request-access' %><span class="icon fr-icon-arrow-down-line fr-mr-3w" aria-hidden="true"></span>
          <% if @fiche_pratique.list_api.present? %>
            <%= link_to t('.link_list_api'), anchor: 'list-api' %><span class="icon fr-icon-arrow-down-line" aria-hidden="true"></span>
          <% end %>
        </div>
      </div>
    </section>


      <section class="role fr-background-grey">
        <h2 class="role--title" id="<%= @fiche_pratique.role[:anchor] %>"><%= @fiche_pratique.role[:title] %></h2>
        <div class="role--content"><%= markdown_to_html(@fiche_pratique.role[:content]) %></div>
        <% if @fiche_pratique.use_case_examples.present? %>
          <h2 class="use_case_examples--title" id="<%= @fiche_pratique.use_case_examples[:anchor] %>"><%= @fiche_pratique.use_case_examples[:title] %></h2>
          <div class="use_case_examples--content"><%= markdown_to_html(@fiche_pratique.use_case_examples[:content]) %></div>
        <% end %>
      </section>


    <% if @fiche_pratique.list_api.present? %>
      <section class="list_api fr-background-default-white">
        <h2 id="list-api"><%= t('.link_list_api') %><span class="fr-ml-2v fr-text--light">"<%= @fiche_pratique.name %>"</span></h2>
        <div class="list_api--content"><%= markdown_to_html(@fiche_pratique.list_api[:content]) %></div>
        <% if @fiche_pratique.endpoints.any? %>
          <%= render 'shared/cas_usages/endpoints_table', endpoints: @fiche_pratique.endpoints %>
        <% end %>
      </section>
    <% end %>

    <% if @fiche_pratique.users.present? %>
      <section class="users fr-background-grey">
        <h2 class="users--title" id="<%= @fiche_pratique.users[:anchor] %>"><%= @fiche_pratique.users[:title] %></h2>
        <div class="users--content"><%= markdown_to_html(@fiche_pratique.users[:content]) %></div>
      </section>
    <% end %>

    <% if @fiche_pratique.legal_context.present? %>
      <section class="legal_context fr-background-default-white fr-pb-1v">
        <h2 id="legal_context" class="legal_context--title"><%= t('.legal_context.title') %></h2>
        <div class="legal_context--content "><%= markdown_to_html(@fiche_pratique.legal_context[:content]) %></div>
      </section>
    <% end %>

    
    <% if @fiche_pratique.request_access.present? %>
      <section class="request_access fr-background-default-white">
        <h2 id="request-access" class="request_access--title"><%= @fiche_pratique.request_access[:title] || t('.request_access.title') %></h2>
        <div class="request_access--content">
          <p class="fr-text--lg"><%= @fiche_pratique.request_access[:description] || t('.request_access.description') %>
          </p>
          <a href="<%= @fiche_pratique.request_access_url %>" class="fr-btn fr-mt-5v fr-mb-4w" target='_blank' rel="noopener noreferrer">
            <%= @fiche_pratique.request_access[:link] || t('.request_access.link') %><span class="fr-text--bold fr-ml-1v"><%= @fiche_pratique.name %></span><span class="fr-sr-only">(nouvelle fenêtre)</span>
          </a>
          <% sub_description = @fiche_pratique.request_access.fetch(:sub_description) { t('.request_access.sub_description') } %>
          <% if sub_description.present? %>
            <p class="fr-mb-0-5v">
              <%= sub_description %>
            </p>
          <% end %>
        </div>
        <div class="request_access--content"><%= markdown_to_html(@fiche_pratique.request_access[:content]) %></div>
      </section>
    <% end %>

    <section class="other-use-cases fr-background-grey">
      <%= render partial: 'shared/cas_usages/others', locals: { api: } %>
    </section>
  </div>
</div>
