<% content_for :page_title, @authorization_request.intitule %>
<div class="fr-container">
  <%= render partial: 'shared/authorization_requests/breadcrumb', locals: { authorization_request: @authorization_request } %>

  <div class="fr-grid-row">
    <div class="fr-col-12">
      <header class="fr-mb-4w">
        <%= render partial: 'shared/authorization_requests/header', locals: { authorization_request: @authorization_request } %>

        <div class="fr-mt-3w">
          <%= external_link_to datapass_authorization_request_url(@authorization_request),
            class: %w(fr-btn fr-btn--lg fr-icon-external-link-line fr-btn--icon-right) do %>
            <%= t('.datapass_cta', external_id: @authorization_request.external_id) %>
          <% end %>
        </div>
      </header>

      <% active_tokens, inactive_tokens = @tokens.partition(&:active?) %>
      <section id="authorization_request_tokens" class="fr-mb-6w">
        <h2 class="fr-h3">
          <%= t('.tokens.title') %>
          <span class="fr-text--md fr-text-mention--grey"><%= t('.tokens.count', count: active_tokens.size, max: AuthorizationRequest::MAX_ACTIVE_TOKENS) %></span>
        </h2>

        <% unless @authorization_request.eligible_for_token_creation? %>
          <div class="fr-alert fr-alert--info fr-alert--sm fr-mb-3w">
            <p><%= t(".tokens.creation_closed.#{@authorization_request.status}", default: t('.tokens.creation_closed.default')) %></p>
          </div>
        <% end %>

        <div class="fr-grid-row fr-grid-row--gutters">
          <% active_tokens.each do |token| %>
            <div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
              <%= render partial: 'shared/authorization_requests/token_card', locals: { token: } %>
            </div>
          <% end %>

          <% if policy(@authorization_request).create_token? %>
            <div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
              <div class="fr-tile fr-tile--horizontal fr-enlarge-link" id="new_token_tile">
                <div class="fr-tile__body">
                  <div class="fr-tile__content">
                    <h3 class="fr-tile__title">
                      <%= link_to t('.tokens.create.title'),
                        new_authorization_request_token_path(authorization_request_id: @authorization_request.id),
                        id: :new_token_link,
                        aria: { controls: 'main-modal' },
                        data: { fr_opened: false, turbo_frame: 'main-modal-content' } %>
                    </h3>
                    <p class="fr-tile__detail"><%= t('.tokens.create.detail') %></p>
                  </div>
                </div>
                <div class="fr-tile__header">
                  <span class="fr-icon-add-circle-line fr-icon--lg" aria-hidden="true"></span>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <% if @authorization_request.eligible_for_token_creation? && @authorization_request.active_tokens_limit_reached? %>
          <p id="active_tokens_limit_reached" class="fr-mt-2w fr-text--sm"><%= t('.tokens.limit_reached', max: AuthorizationRequest::MAX_ACTIVE_TOKENS) %></p>
        <% end %>

        <% if active_tokens.empty? && @authorization_request.eligible_for_token_creation? %>
          <p class="fr-mt-2w"><%= t('.tokens.none') %></p>
        <% end %>

        <% if inactive_tokens.any? %>
          <section class="fr-accordion fr-mt-3w" id="inactive_tokens">
            <h3 class="fr-accordion__title">
              <button type="button" class="fr-accordion__btn" aria-expanded="false" aria-controls="inactive_tokens_content">
                <%= t('.tokens.inactive', count: inactive_tokens.size) %>
              </button>
            </h3>
            <div class="fr-collapse" id="inactive_tokens_content">
              <div class="fr-grid-row fr-grid-row--gutters">
                <% inactive_tokens.each do |token| %>
                  <div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
                    <%= render partial: 'shared/authorization_requests/token_card', locals: { token: } %>
                  </div>
                <% end %>
              </div>
            </div>
          </section>
        <% end %>
      </section>

      <% if @active_delegations.any? || (@available_editors.any? && @authorization_request.eligible_for_token_creation?) %>
        <section id="habilitation_delegations" class="fr-mb-6w">
          <h2 class="fr-h3"><%= t('.delegations.title').html_safe %></h2>
          <p class="fr-mb-2w"><%= t('.delegations.description') %></p>

          <% if @active_delegations.any? %>
            <div class="fr-table fr-table--stretch">
              <div class="fr-table__wrapper">
                <div class="fr-table__container">
                  <div class="fr-table__content">
                    <table>
                      <caption class="fr-sr-only"><%= t('.delegations.title').html_safe %></caption>
                      <thead>
                        <tr>
                          <th scope="col"><%= t('.delegations.editor') %></th>
                          <th scope="col"><%= t('.delegations.status') %></th>
                          <th scope="col"><%= t('.delegations.actions') %></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% @active_delegations.each do |delegation| %>
                          <tr id="<%= dom_id(delegation) %>">
                            <td><%= delegation.editor.name %></td>
                            <td>
                              <p class="fr-badge fr-badge--green-emeraude"><%= t('.delegations.status_active') %></p>
                            </td>
                            <td>
                              <%= button_to t('.delegations.revoke'), authorization_request_delegation_path(@authorization_request, delegation), method: :delete, class: 'fr-btn fr-btn--secondary' %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <% if @available_editors.any? && @authorization_request.eligible_for_token_creation? %>
            <%= form_with url: authorization_request_delegations_path(@authorization_request), method: :post, class: 'fr-mt-2w' do |f| %>
              <div class="fr-select-group">
                <%= f.label :editor_id, t('.delegations.add_label'), class: 'fr-label' %>
                <%= f.select :editor_id, @available_editors.map { |e| [e.name, e.id] }, { prompt: t('.delegations.select_prompt') }, class: 'fr-select' %>
              </div>
              <%= f.submit t('.delegations.add_submit'), class: 'fr-btn fr-mt-1w' %>
            <% end %>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>
</div>
