<div class="fr-col-12 fr-col-md-6 fr-col-lg-4">
  <div class="fr-card fr-card--no-arrow token-card" id="<%= dom_id(token) %>">
    <div class="fr-card__body">
      <div class="fr-card__content">
        <h3 class="fr-card__title"><%= token.name %></h3>
        <p class="fr-card__desc">
          <%= t("shared.authorization_requests.token_card.end_date.#{token.card_status}", date: friendly_date_from_timestamp(token.card_end_timestamp)) %><br>
          <span class="fr-text--xs fr-text-mention--grey">
            <% if token.creator %>
              <%= t('shared.authorization_requests.token_card.created_by', date: friendly_date_from_timestamp(token.created_at), name: token.creator.full_name) %>
            <% else %>
              <%= t('shared.authorization_requests.token_card.created', date: friendly_date_from_timestamp(token.created_at)) %>
            <% end %>
          </span>
        </p>
        <div class="fr-card__start">
          <%= render 'shared/authorization_requests/token_status_badge', token: %>
        </div>
      </div>
      <div class="fr-card__footer">
        <%= render 'shared/tokens/reveal_token_button', token:, extra_classes: 'fr-btn--sm fr-mb-2w' %>
        <ul class="fr-btns-group fr-btns-group--sm fr-btns-group--inline fr-btns-group--icon-left">
          <li>
            <%= link_to t('shared.authorization_requests.token_card.transfer'),
              token_transfer_path(id: token.id),
              class: 'fr-btn fr-btn--sm fr-btn--tertiary fr-icon-send-plane-line',
              aria: { controls: 'main-modal' },
              data: { fr_opened: false, turbo_frame: 'main-modal-content' } %>
          </li>
          <% if policy(token.object).extend? %>
            <%= render 'shared/authorization_requests/token_modal_link', token:, action: :extension %>
          <% end %>
          <li>
            <%= link_to t('shared.authorization_requests.token_card.stats'),
              token_stats_path(id: token.id),
              id: dom_id(token, :stats_link),
              class: 'fr-btn fr-btn--sm fr-btn--tertiary fr-icon-line-chart-line' %>
          </li>
          <% if policy(token.object).revoke? %>
            <%= render 'shared/authorization_requests/token_modal_link', token:, action: :revocation %>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
