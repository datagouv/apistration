<div class="fr-card fr-card--no-arrow" id="<%= dom_id(token) %>">
  <div class="fr-card__body">
    <div class="fr-card__content">
      <h3 class="fr-card__title"><%= token.name %></h3>
      <div class="fr-card__start">
        <ul class="fr-badges-group">
          <li>
            <p class="fr-badge fr-badge--sm fr-badge--<%= t("shared.authorization_requests.token_card.status.color.#{token.card_status}") %>">
              <%= t("shared.authorization_requests.token_card.status.label.#{token.card_status}") %>
            </p>
          </li>
        </ul>
      </div>
      <div class="fr-card__desc">
        <p class="fr-mb-1v"><%= t("shared.authorization_requests.token_card.end_date.#{token.card_status}", date: friendly_date_from_timestamp(token.card_end_timestamp)) %></p>
        <p class="fr-mb-1v fr-text--sm" id="<%= dom_id(token, :allowed_ips) %>">
          <% if token.allowed_ips.any? %>
            <%= t('shared.authorization_requests.token_card.allowed_ips') %>
            <% token.allowed_ips_as_strings.each do |ip| %><code><%= ip %></code> <% end %>
          <% else %>
            <span class="fr-text-mention--grey"><%= t('shared.authorization_requests.token_card.no_allowed_ips') %></span>
          <% end %>
        </p>
        <p class="fr-mb-0 fr-text--xs">
          <% if token.creator %>
            <%= t('shared.authorization_requests.token_card.created_by', date: friendly_date_from_timestamp(token.created_at), name: token.creator.full_name) %>
          <% else %>
            <%= t('shared.authorization_requests.token_card.created', date: friendly_date_from_timestamp(token.created_at)) %>
          <% end %>
        </p>
      </div>
    </div>
    <div class="fr-card__footer">
      <ul class="fr-btns-group fr-btns-group--sm fr-btns-group--inline-sm fr-btns-group--icon-left">
        <% if token.active? %>
          <li>
            <%= render partial: 'shared/tokens/reveal_token_button', locals: { token:, extra_classes: 'fr-btn--sm' } %>
          </li>
          <li>
            <%= link_to t('shared.authorization_requests.token_card.transfer'),
              token_transfer_path(id: token.id),
              class: 'fr-btn fr-btn--sm fr-btn--tertiary fr-icon-send-plane-line',
              aria: { controls: 'main-modal' },
              data: { fr_opened: false, turbo_frame: 'main-modal-content' } %>
          </li>
        <% end %>
        <li>
          <%= link_to t('shared.authorization_requests.token_card.stats'),
            token_stats_path(id: token.id),
            id: dom_id(token, :stats_link),
            class: 'fr-btn fr-btn--sm fr-btn--tertiary fr-icon-line-chart-line' %>
        </li>
        <% if token.active? %>
          <li>
            <%= link_to t('shared.authorization_requests.token_card.revoke'),
              token_revocation_path(id: token.id),
              id: dom_id(token, :revocation_link),
              class: 'fr-btn fr-btn--sm fr-btn--tertiary fr-icon-close-circle-line',
              aria: { controls: 'main-modal' },
              data: { fr_opened: false, turbo_frame: 'main-modal-content' } %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
