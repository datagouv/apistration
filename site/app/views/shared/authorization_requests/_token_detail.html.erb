<div id="<%= dom_id(token, :panel) %>">
  <div class="token-panel__header">
    <h3 class="fr-h5 fr-mb-0"><%= token.name %></h3>
    <%= render 'shared/authorization_requests/token_status_badge', token: %>
  </div>

  <p class="fr-mt-2w fr-mb-1v"><%= t("shared.authorization_requests.token_card.end_date.#{token.card_status}", date: friendly_date_from_timestamp(token.card_end_timestamp)) %></p>
  <p class="fr-text--xs fr-mb-3w">
    <% if token.creator %>
      <%= t('shared.authorization_requests.token_card.created_by', date: friendly_date_from_timestamp(token.created_at), name: token.creator.full_name) %>
    <% else %>
      <%= t('shared.authorization_requests.token_card.created', date: friendly_date_from_timestamp(token.created_at)) %>
    <% end %>
  </p>

  <% if token.active? %>
    <p class="fr-text--bold fr-mb-1w"><%= t('.value.title') %></p>
    <p class="fr-text--sm fr-mb-2w"><%= t('.value.hint') %></p>
    <%= render partial: 'shared/tokens/reveal_token_button', locals: { token:, extra_classes: 'fr-btn--sm' } %>
  <% end %>

  <ul class="fr-btns-group fr-btns-group--sm fr-btns-group--inline-sm fr-btns-group--icon-left fr-mt-3w">
    <% if token.active? %>
      <li>
        <%= link_to t('shared.authorization_requests.token_card.transfer'),
          token_transfer_path(id: token.id),
          class: 'fr-btn fr-btn--sm fr-btn--secondary fr-icon-send-plane-line',
          aria: { controls: 'main-modal' },
          data: { fr_opened: false, turbo_frame: 'main-modal-content' } %>
      </li>
    <% end %>
    <% if policy(token.object).extend? %>
      <%= render 'shared/authorization_requests/token_panel_link', token:, action: :extension %>
    <% end %>
    <li>
      <%= link_to t('shared.authorization_requests.token_card.stats'),
        token_stats_path(id: token.id),
        id: dom_id(token, :stats_link),
        class: 'fr-btn fr-btn--sm fr-btn--tertiary fr-icon-line-chart-line',
        data: { turbo_frame: '_top' } %>
    </li>
    <% if policy(token.object).revoke? %>
      <%= render 'shared/authorization_requests/token_panel_link', token:, action: :revocation %>
    <% end %>
  </ul>
</div>
