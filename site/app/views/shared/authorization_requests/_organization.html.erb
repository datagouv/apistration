<% if authorization_request.organization&.denomination.present? %>
  <a href="https://annuaire-entreprises.data.gouv.fr/etablissement/<%= authorization_request.siret %>" target="_blank">
    <%= authorization_request.organization.denomination %> (<%= authorization_request.siret %>)
  </a>
<% elsif authorization_request.siret.present? %>
  <a href="https://annuaire-entreprises.data.gouv.fr/etablissement/<%= authorization_request.siret %>" target="_blank">
    <%= authorization_request.siret %>
  </a>
<% else %>
  SIRET non renseigné
<% end %>
