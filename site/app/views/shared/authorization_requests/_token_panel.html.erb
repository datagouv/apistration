<div class="token-panel" id="token_panel">
  <% if @panel == :new %>
    <%= render 'shared/self_service_tokens/form', authorization_request:, token: @token %>
  <% elsif @panel == :revocation %>
    <%= render 'shared/self_service_tokens/revocation_form', authorization_request:, token: @selected_token %>
  <% elsif @panel == :extension %>
    <%= render 'shared/token_extensions/form', authorization_request:, token: @selected_token, form_token: @token, error: @extension_error %>
  <% elsif @selected_token %>
    <%= render 'shared/authorization_requests/token_detail', token: @selected_token %>
  <% end %>
</div>
