<h2 id="historique" class="fr-mt-md-5w fr-mt-8w">
  <%= t('shared.endpoints.historique.title') %>
</h2>
<%= markdown_to_html(endpoint.historique) %>
<% if endpoint.old_endpoints.any? %>
  <p class="fr-text--bold fr-mb-1v fr-mt-4w"><%= t('shared.endpoints.historique.old_endpoints.description') %></p>
  <ul>
    <% endpoint.old_endpoints.each do |old_endpoint| %>
      <li>
        <%= link_to old_endpoint.uid, endpoint_path(uid: old_endpoint.uid) %>
      </li>
    <% end %>
  </ul>
  <p class="fr-text--sm fr-mt-4w"><%= t("#{endpoint.api}.endpoints.show.historique.old_endpoints.link_documentation_html") %></p>
<% end %>
