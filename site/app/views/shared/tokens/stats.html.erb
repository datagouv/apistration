<% content_for :title, t('.title', title: @token&.intitule || 'Jeton') %>
<div class="fr-grid-row">
  <div class="fr-col-12 fr-pb-2w">
    <div class="fr-card fr-card--horizontal fr-card--no-arrow">
      <div class="fr-card__body">
        <div class="fr-card__content">
          <h2 class="fr-card__title">
            <%= t('.title', title: @token.intitule) %>

            <span class="fr-text--sm fr-m-0 pull-right">
              <%= link_to t('.links.user_tokens', external_id: @token.authorization_request.external_id).html_safe, authorization_request_path(id: @token.authorization_request.id), id: :user_tokens_link, class: %w(fr-link fr-link--sm fr-icon-arrow-right-line fr-link--icon-right) %>
            </span>
          </h2>

          <div class="fr-card__desc">
            <ul>
              <li>
                <span><%= t('.details.internal_id', id: @token.id) %></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="fr-col-12 fr-pb-2w">
    <div class="fr-tabs">
      <ul class="fr-tabs__list" role="tablist" aria-label="stats-for-period-tabs">
        <% TokenStatsFacade::PERIODS.keys.each_with_index do |period, index| %>
          <li role="presentation">
          <button id="tabpanel-<%= period %>" class="fr-tabs__tab fr-icon-checkbox-line fr-tabs__tab--icon-left" tabindex="<%= index == 0 ? '0' : '-1' %>" role="tab" aria-selected="<%= index == 0 ? "true" : "false" %>" aria-controls="tabpanel-<%= period %>-panel">
              <%= t(".tabs.#{period}") %>
            </button>
          </li>
        <% end %>
      </ul>

      <% TokenStatsFacade::PERIODS.keys.each_with_index do |period, index| %>
        <% period_path = url_for(action: :stats_period, id: @token.id, period:) %>
        <div id="tabpanel-<%= period %>-panel" class="fr-tabs__panel <%= index == 0 ? 'fr-tabs__panel--selected' : '' %>" role="tabpanel" aria-labelledby="tabpanel-<%= period %>" tabindex="0" data-controller="tab-frame" data-action="dsfr.disclose->tab-frame#load">
          <%= render 'shared/tokens/stats_frame', id: "token_stats_#{period}", src: (period_path if index == 0), data: { tab_frame_target: 'frame', src: period_path } %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="fr-col-12 fr-pb-2w">
    <h3>
      <%= t('.requests_details.title', limit: TokenStatsFacade::LAST_REQUESTS_LIMIT) %>
    </h3>

    <%= render 'shared/tokens/stats_frame', id: 'token_stats_last_requests', src: url_for(action: :last_requests, id: @token.id) %>
  </div>
</div>
