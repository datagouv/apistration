<%= turbo_frame_tag "token_stats_last_requests" do %>
  <% if @requests.empty? %>
    <p class="fr-py-2w"><%= t('shared.tokens.stats.no_calls') %></p>
  <% else %>
    <%= render layout: 'shared/dsfr_table', locals: {
      classes: 'fr-table--no-caption',
      caption: t('shared.tokens.stats.requests_details.caption'),
      headers: %i[timestamp path params status].map { |column| t("shared.tokens.stats.requests_details.columns.#{column}") }
    } do %>
      <% @requests.each do |request| %>
        <tr>
          <td><%= l(request.timestamp, format: :compact_with_hours) %></td>
          <td><code><%= request.path %></code></td>
          <td class="token-stats-params"><code><%= request.params.to_json %></code></td>
          <td><%= request.status %></td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
<% end %>
