<%# locals: (query:, filter:) -%>
<%
  fmt = ->(b) { dashboard_bucket_label(b, filter.interval) }
  metrics = %i[total unique cached]
%>
<section class="fr-mt-4w">
  <h2><%= t('.title') %></h2>
  <p><%= t('.description') %></p>

  <div class="fr-grid-row fr-grid-row--gutters fr-mb-2w">
    <% metrics.each do |k| %>
      <%= render 'shared/dsfr_chart/kpi', label: t("provider.dashboard.show.kpis.#{k}"), value: number_with_delimiter(query.public_send("#{k}_calls")) %>
    <% end %>
  </div>

  <%= render 'shared/dsfr_chart/line',
    title: t('.charts.evolution'),
    series: metrics.map { |k|
      { label: t("provider.dashboard.show.kpis.#{k}"),
        points: query.evolution.map { |p| [fmt.call(p[:bucket]), p[k]] } }
    } %>

  <%= render 'shared/dsfr_chart/bar',
    title: t('.charts.per_endpoint'),
    categories: query.per_endpoint.map { |r| r[:endpoint] },
    series: metrics.map { |k|
      { label: t("provider.dashboard.show.kpis.#{k}"),
        values: query.per_endpoint.map { |r| r[k] } }
    } %>

  <% metrics.each do |metric| %>
    <%= render 'shared/dsfr_chart/line',
      title: t(".charts.evolution_per_endpoint.#{metric}"),
      series: query.evolution_per_endpoint_series(metric, &fmt) %>
  <% end %>
</section>
