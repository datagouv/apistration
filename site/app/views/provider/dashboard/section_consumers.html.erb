<%
  consumers = @query.consumers(page: params[:page])
  fmt = ->(b) { dashboard_bucket_label(b, @filter.interval) }
%>
<%= turbo_frame_tag 'dashboard_consumers' do %>
  <section class="fr-mt-4w">
    <h2><%= t('.title') %></h2>

    <div class="fr-mb-2w">
      <p class="fr-text--sm fr-text--bold fr-mb-0"><%= t('.total_count', count: @query.total_consumers) %></p>
      <% if @filter.api.to_s == 'particulier' && @query.france_connect_consumers.positive? %>
        <p class="fr-text--sm fr-mb-0"><%= t('.france_connect_count', count: @query.france_connect_consumers) %></p>
      <% end %>
    </div>

    <% chart_title = t('.charts.evolution') %>
    <% chart_title += " (#{t('.charts.includes_france_connect')})" if @filter.api.to_s == 'particulier' %>
    <%= render 'shared/dsfr_chart/line',
      title: chart_title,
      series: [
        { label: t('.charts.evolution_series'),
          points: @query.consumers_evolution.map { |p| [fmt.call(p[:bucket]), p[:value]] } },
        { label: t('.charts.cumulative_series'),
          points: @query.consumers_cumulative_evolution.map { |p| [fmt.call(p[:bucket]), p[:value]] } }
      ] %>

    <% if @query.multiple_endpoints? %>
      <%= render 'shared/dsfr_chart/line',
        title: t('.charts.evolution_per_endpoint'),
        series: @query.consumers_evolution_per_endpoint_series(&fmt) %>

      <%= render 'shared/dsfr_chart/line',
        title: t('.charts.cumulative_per_endpoint'),
        series: @query.consumers_cumulative_evolution_per_endpoint_series(&fmt) %>
    <% end %>

    <p><%= t('.description') %></p>
    <%= render 'provider/dashboard/consumers_table', consumers: consumers %>
    <%= paginate consumers %>
    <p class="fr-mt-1w">
      <% csv_path = controller_path == 'admin/provider_dashboards' \
           ? consumers_export_admin_provider_dashboard_path(id: @filter.provider.uid, filter: filter_params) \
           : provider_consumers_csv_path(provider_uid: @filter.provider.uid, filter: filter_params) %>
      <%= link_to csv_path, class: 'fr-link fr-link--download', data: { turbo: false } do %>
        Télécharger la liste complète
        <span class="fr-link__detail">CSV</span>
      <% end %>
    </p>
  </section>
<% end %>
