<%
  habilitations = @query.habilitations(page: params[:page])
  fmt = ->(b) { dashboard_bucket_label(b, @filter.interval) }
%>
<%= turbo_frame_tag 'dashboard_habilitations' do %>
  <section class="fr-mt-4w">
    <h2><%= t('.title') %></h2>

    <ul class="fr-text--sm fr-mb-2w">
      <li><%= t('.total_count', count: @query.total_habilitations) %></li>
    </ul>

    <%= render 'shared/dsfr_chart/line',
      title: t('.charts.evolution'),
      series: [
        { label: t('.charts.evolution_series'),
          points: @query.habilitations_evolution.map { |p| [fmt.call(p[:bucket]), p[:value]] } },
        { label: t('.charts.cumulative_series'),
          points: @query.habilitations_cumulative_evolution.map { |p| [fmt.call(p[:bucket]), p[:value]] } }
      ] %>

    <p><%= t('.description') %></p>
    <p>
      <%= link_to t('.download_csv'),
                  provider_habilitations_csv_path(provider_uid: @filter.provider.uid, filter: filter_params),
                  class: 'fr-btn fr-btn--secondary fr-icon-download-line fr-btn--icon-left',
                  data: { turbo: false } %>
    </p>
    <%= render 'provider/dashboard/habilitations_table', habilitations: habilitations %>
    <%= paginate habilitations %>
  </section>
<% end %>
