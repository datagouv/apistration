<div class="fr-grid-row fr-grid-row--gutters">
  <div class="fr-col-12">
    <h1><%= t('.title', name: current_provider.name) %></h1>

    <%= render 'provider/dashboard/filter', filter: @filter, provider: current_provider %>

    <% if @query.total_calls.zero? %>
      <div class="fr-callout fr-mb-3w">
        <p class="fr-callout__text"><%= t('.empty_period') %></p>
      </div>
    <% else %>
      <%= render 'provider/dashboard/section_global', query: @query, filter: @filter %>
      <%= render 'provider/dashboard/section_success', query: @query, filter: @filter %>
      <%= render 'provider/dashboard/section_duration', query: @query, filter: @filter %>
    <% end %>

    <section class="fr-mt-4w">
      <h2><%= t('.sections.consumers.title') %></h2>
      <p><%= t('.sections.consumers.description') %></p>
      <%= render 'provider/dashboard/consumers_table', consumers: @query.consumers %>
    </section>

    <section class="fr-mt-4w">
      <h2><%= t('.sections.habilitations.title') %></h2>
      <p><%= t('.sections.habilitations.description') %></p>
      <%= render 'provider/dashboard/habilitations_table', habilitations: @query.habilitations %>
    </section>
  </div>
</div>
