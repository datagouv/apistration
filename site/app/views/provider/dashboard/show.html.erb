<%
  filter_query = request.query_parameters.except('controller', 'action').to_query
  section_url = ->(action) {
    base = controller_path == 'admin/provider_dashboards' \
      ? url_for(controller: '/admin/provider_dashboards', action: "#{action}_section", id: current_provider.uid, only_path: true) \
      : url_for(controller: '/provider/dashboard', action: "#{action}_section", provider_uid: current_provider.uid, only_path: true)
    filter_query.empty? ? base : "#{base}?#{filter_query}"
  }
%>
<div class="fr-grid-row fr-grid-row--gutters">
  <div class="fr-col-12">
    <h1><%= t('.title', name: current_provider.name) %></h1>

    <%= render 'provider/dashboard/filter', filter: @filter, provider: current_provider %>

    <% ProviderDashboardFiltering::SECTIONS.each do |section| %>
      <%= turbo_frame_tag "dashboard_#{section}", src: section_url.call(section), loading: :lazy do %>
        <%= render 'provider/dashboard/loading', section: section %>
      <% end %>
    <% end %>
  </div>
</div>
