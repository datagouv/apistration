<%= render partial: "mailers/header" %>
<mj-section mj-class="section-main">
  <mj-column>
    <mj-text>
      <p>Bonjour,</p>
      <p>
        L'équipe <%= api_full_name %> a programmé la révocation du jeton <b>« <%= @token.name %> »</b>
        de la demande n°<%= @authorization_request.external_id %> (<%= @intitule %>) le <b><%= @blacklisted_at %></b>.
        Créez un nouveau jeton d'ici là depuis la page de la demande et mettez à jour votre logiciel.
      </p>
      <% if @comment.present? %>
        <p>
          <b>Commentaire de l'équipe <%= api_full_name %> :</b><br />
          <%= @comment %>
        </p>
      <% end %>
    </mj-text>
    <mj-button href="<%= @authorization_request_url %>">
      Créer un nouveau jeton
    </mj-button>
    <mj-text>
      <p><b>L'équipe <%= api_full_name %></b></p>
    </mj-text>
  </mj-column>
</mj-section>
<%= render partial: "mailers/footer" %>
