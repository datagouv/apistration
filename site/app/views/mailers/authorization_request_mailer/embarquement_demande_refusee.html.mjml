<%= render partial: "mailers/header" %>
<mj-section mj-class="section-banner" background-color="#f7bfc3">
  <mj-column>
    <mj-text>
      <h1>
        <%= @update ? "Votre demande de mise à jour #{api_full_name}" : "Votre demande d'accès à l'#{api_full_name}" %>
        <b>a été refusée <%= @update ? '✒️' : '🚫' %></b>
      </h1>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section mj-class="section-main">
  <mj-column>
    <mj-text>
      <%= render partial: "greetings", locals: { entity: "demandeur" } %>
      <p>
        <%= @update ? "Votre demande de mise à jour de l'habilitation" : 'Votre demande d’habilitation' %> <%= api_full_name %> n°<%= @authorization_request.external_id %> a été
        <b>refusée par notre service juridique</b>
        .
      </p>
      <p>Pour connaître les raisons de ce refus, veuillez consulter votre demande sur 
        <a target="_blank" href="<%= @authorization_request_datapass_url %>">
          <%= @authorization_request_datapass_url %>
        </a>
        &nbsp;:
      </p>
    </mj-text>
    <mj-button mj-class="button-secondary" href="<%= @authorization_request_datapass_url %>">
      Lire les commentaires de l'instructeur&nbsp;📝
    </mj-button>
    <mj-text>
      <p>
        <% if @update %>
          Votre habilitation n°<a target="_blank" href="<%= @authorization_request_datapass_url %>"><%= @authorization_request.external_id %></a> <b>reste valide dans les termes validés initialement</b>.
        <% else %>
          Bonne continuation,
        <% end %>
        <br />
        <b><%= api_full_name %></b>
      </p>
    </mj-text>
  </mj-column>
</mj-section>
<%= render partial: "block_refusal_might_be_error" unless @update %>
<%= render partial: "mailers/footer" %>
