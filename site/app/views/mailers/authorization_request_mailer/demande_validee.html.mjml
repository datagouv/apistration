<%= render partial: "mailers/header" %>
<mj-section mj-class="section-main">
  <mj-column>
    <mj-text>
      <p>Bonjour,</p>
      <% if @update %>
        <p>
          La mise à jour de votre demande n°<%= @authorization_request.external_id %> « <%= @authorization_request.intitule %> » a été validée.
          Vos jetons restent valables.
        </p>
      <% elsif @delegated_editor %>
        <p>
          Votre demande n°<%= @authorization_request.external_id %> « <%= @authorization_request.intitule %> » à l'<%= api_full_name %> a été validée.
          Elle est déléguée à l'éditeur <b><%= @delegated_editor.name %></b>, qui appelle l'API pour votre compte avec ses propres accès :
          vous n'avez rien d'autre à faire.
        </p>
      <% elsif @token_generating_editor %>
        <p>
          Votre demande n°<%= @authorization_request.external_id %> « <%= @authorization_request.intitule %> » à l'<%= api_full_name %> a été validée.
          L'éditeur <b><%= @token_generating_editor.name %></b> génère et récupère le jeton depuis son espace éditeur :
          vous n'avez rien d'autre à faire.
        </p>
      <% else %>
        <p>
          Votre demande n°<%= @authorization_request.external_id %> « <%= @authorization_request.intitule %> » à l'<%= api_full_name %> a été validée.
          Vous pouvez créer votre jeton d'accès depuis la page de la demande.
        </p>
        <% if @client_software_editor %>
          <p>
            Une fois le jeton créé, saisissez-le dans le logiciel <b><%= @client_software_editor.name %></b>,
            ou transmettez-le à votre prestataire avec le bouton « Transmettre ».
          </p>
        <% end %>
      <% end %>
    </mj-text>
    <mj-button href="<%= @authorization_request_url %>">
      <%= @update || @delegated_editor || @token_generating_editor ? 'Voir la demande' : 'Créer mon jeton' %>
    </mj-button>
    <mj-text>
      <p><b>L'équipe <%= api_full_name %></b></p>
    </mj-text>
  </mj-column>
</mj-section>
<%= render partial: "mailers/footer" %>
