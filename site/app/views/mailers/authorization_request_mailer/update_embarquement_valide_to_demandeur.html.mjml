<%= render partial: "mailers/header" %>
<mj-section mj-class="section-banner" background-color="#e3ebd3">
  <mj-column>
    <mj-text>
      <h1>
        Votre habilitation <%= api_full_name %>
        <b>a été mise à jour ✅</b>
      </h1>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section mj-class="section-main">
  <mj-column>
    <mj-text>
      <%= render partial: "greetings", locals: { entity: "demandeur" } %>
      <mj-text>
        <p>
          Votre
          <b>demande de mise à jour de l'<a target="_blank" href="<%= @authorization_request_datapass_url %>">habilitation <%= api_full_name %> n°<%= @authorization_request.external_id %></a> a bien été validée</b>
          par notre service juridique !&nbsp;
        </p>
        <p>
          Suite à cette mise à jour, la durée de vie de votre
          <b>jeton d'accès technique&nbsp;🔑</b> a été prolongée de 18 mois.
        </p>
      </mj-text>
    </mj-text>
    <mj-text>
      <p>
        À bientôt
        <br />
        <b><%= api_full_name %></b>
      </p>
    </mj-text>
  </mj-column>
</mj-section>
<%= render partial: "mailers/footer" %>
