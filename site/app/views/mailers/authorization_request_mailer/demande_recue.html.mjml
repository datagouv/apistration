<%= render partial: "mailers/header" %>
<mj-section mj-class="section-banner" background-color="#d5dbef">
  <mj-column>
    <mj-divider />
    <mj-text>
      <h1>
        <%= @update ? 'Votre demande de mise à jour' : "Votre demande d'accès" %> <b>a bien été reçue par nos services</b>&nbsp;📬
      </h1>
    </mj-text>
  </mj-column>
</mj-section>
<mj-section mj-class="section-main">
  <mj-column>
    <mj-text>
      <%= render partial: "greetings", locals: { entity: "demandeur" } %>
      <p>
        <b>
          <% if @update %>
            Votre demande de mise à jour de l'habilitation n°<%= @authorization_request.external_id %> a bien été reçue.
          <% else %>
            Votre demande d’habilitation <%= api_full_name %> n°<%= @authorization_request.external_id %> a bien été
            enregistrée.
          <% end %>
        </b>
        Notre service juridique va en prendre connaissance dans les meilleurs délais.&nbsp;
      </p>
      <p>
        📝 Vous pouvez continuer à consulter et modifier votre demande<%= ' de mise à jour' if @update %> à tout moment en suivant le lien suivant&nbsp;:
        <a target="_blank" href="<%= @authorization_request_datapass_url %>">
          <%= @authorization_request_datapass_url %>
        </a>
      </p>
      <p style="margin-top: 20px;">
        À bientôt 👋
        <br />
        <b><%= api_full_name %></b>
      </p>
    </mj-text>
  </mj-column>
</mj-section>
<% unless @update %>
  <%= render partial: "block_accelerer_demande" %>
  <%= render partial: "block_newsletter" %>
<% end %>
<%= render partial: "mailers/footer" %>
