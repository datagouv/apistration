<mj-button href="<%= api_url(:login) %>">
  <% if entity == "editeur" %>
    Se connecter au compte <%= api_full_name %>
    <br />
    et récupérer/transmettre ma clé d'accès &nbsp;🔑
  <% else %>
    Se connecter
    <br />
    au compte <%= api_full_name %>
  <% end %>
</mj-button>
<mj-text mj-class="secondary-link">
  <a target="_blank" href="<%= api_url(:login) %>"><%= api_url(:login) %></a>
</mj-text>
