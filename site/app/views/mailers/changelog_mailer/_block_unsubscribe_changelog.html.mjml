<mj-section mj-class="section-block">
  <mj-column>
    <mj-text mj-class="secondary-link">
      <p>
        Vous recevez cet email car vous êtes inscrit à la newsletter hebdomadaire des nouveautés d'<%= api_full_name %>.
        <a target="_blank" href="<%= api_url(:changelog_unsubscribe_token, token: @subscription.unsubscribe_token) %>">
          Se désinscrire
        </a>
      </p>
    </mj-text>
  </mj-column>
</mj-section>
