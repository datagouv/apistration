<mj-section background-color="#f6f6f6" padding-top="0px" padding-bottom="0px">
  <mj-column>
    <mj-divider mj-class="footer-divider" />
    <mj-text>
      <ul class="footer-list">
        <li><a target="_blank" href="<%= api_url(:endpoints) %>">Catalogue des API</a></li>
        <li><a target="_blank" href="<%= api_url(:faq_index) %>">FAQ &amp; contact</a></li>
        <li><a target="_blank" href="<%= api_url(:user_profile) %>">Se connecter</a></li>
      </ul>
    </mj-text>
    <mj-divider mj-class="footer-divider" border-color="#e9e9e9"/>
  </mj-column>
</mj-section>
<mj-section>
  <mj-column vertical-align="top" width="33%">
    <mj-image
      alt="Logo officiel de la Direction Interministérielle du Numérique"
      href="<%= api_root_url %>"
      src="<%= attachments['logo-dinum.png'].url %>"
      target="_blank" />
  </mj-column>
  <mj-column vertical-align="top" width="67%">
    <mj-image
      alt="<%= api_specific(:logo_alt) %>"
      href="<%= api_root_url %>"
      src="<%= attachments['logo-api.png'].url %>"
      target="_blank" />
  </mj-column>
</mj-section>
