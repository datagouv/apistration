#!/usr/bin/env ruby
require_relative 'sentry_client'

USAGE = <<~USAGE.freeze
  Usage: bin/sentry/events <ISSUE_ID> [OPTIONS]

  List events for a Sentry issue.

  Options:
    -p, --pages NUM    Number of pages to fetch (100 events/page, default: 1)
    -f, --full         Fetch full event details
  #{SentryCli.project_help}
    -h, --help         Show this help

  Examples:
    bin/sentry/events 123456
    bin/sentry/events 123456 -P siade-site
    bin/sentry/events 123456 -p 5
    bin/sentry/events 123456 --full
USAGE

args = ARGV.dup
project = SentryCli.parse_project!(args)

if args.empty? || args.include?('-h') || args.include?('--help')
  puts USAGE
  exit args.empty? ? 1 : 0
end

issue_id = args.shift
pages = 1
full = false

while args.any?
  case args.shift
  when '-p', '--pages'
    pages = args.shift.to_i
  when '-f', '--full'
    full = true
  end
end

client = SentryClient.new(project: project)

puts "Fetching events for issue #{issue_id} on #{project} (#{pages} page(s))...\n\n"

all_events = []
pages.times do |page|
  events = client.events(issue_id, page: page, full: full)
  all_events.concat(events)
  print '.'
end
puts " #{all_events.count} events\n\n"

format_backend = lambda do |event|
  context = event['context'] || {}
  http_code = context['http_response_code']
  controller = context.dig('params', 'controller')
  [http_code, controller].compact.join(' | ')
end

format_generic = lambda do |event|
  [event['title'], event['message']].compact.reject(&:empty?).first.to_s[0, 80]
end

formatter = client.backend? ? format_backend : format_generic

all_events.each do |event|
  id = event['eventID'][0, 12]
  date = event['dateCreated'][0, 19].gsub('T', ' ')
  info = formatter.call(event)

  puts "#{id} | #{date} | #{info}"
end

puts "\nUse 'bin/sentry/export #{issue_id}' to export to CSV"
