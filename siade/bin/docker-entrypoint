#!/usr/bin/env bash
#
# Script de démarrage de l'image Docker de siade : prépare les dossiers de
# travail, puis lance la commande demandée (Puma par défaut, cf. CMD dans le
# Dockerfile).

# Arrêt immédiat à la première erreur : le conteneur s'arrête avec une erreur
# visible plutôt que de lancer l'application dans un état bancal.
set -euo pipefail

# Recrée les sous-dossiers de travail : dans Kubernetes, tmp/ est un volume
# temporaire qui arrive vide à chaque démarrage et masque ceux de l'image.
mkdir -p tmp/pids tmp/cache "$GNUPGHOME"

# GPG refuse un trousseau de clés lisible par d'autres que son propriétaire.
chmod 700 "$GNUPGHOME"

# Remplace ce script par la commande demandée : elle devient le processus
# principal du conteneur et reçoit directement le signal d'arrêt de Kubernetes.
exec "$@"
